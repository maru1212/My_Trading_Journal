{
  "name": "my-trading-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env.local scripts/migrate.mjs migrate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs migrate",
    "db:status": "node --env-file-if-exists=.env.local scripts/migrate.mjs status",
    "db:adopt": "node --env-file-if-exists=.env.local scripts/migrate.mjs adopt"
  },
  "dependencies": {
    "metaapi.cloud-sdk": "^29.3.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
