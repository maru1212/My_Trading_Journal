# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# MetaTrader 5 sync via https://metaapi.cloud (optional). Use "mock" for a fake account locally.
METAAPI_TOKEN=
# Any long random string; lets Vercel Cron run the daily MT5 sync.
CRON_SECRET=

# Who may create an account. Sign-up is CLOSED by default.
# Comma-separated emails allowed to register (case-insensitive). Leave empty to allow nobody.
ALLOWED_SIGNUP_EMAILS=you@example.com
# "true" opens registration to ANYONE. Keep unset in production.
ALLOW_SIGNUP=
# "true" allows METAAPI_TOKEN=mock in production. Leave unset; the mock already works in dev/test.
ALLOW_MT5_MOCK=

# Optional: Postgres for the database tests (a throwaway schema is created and dropped per run).
DATABASE_URL_TEST=
